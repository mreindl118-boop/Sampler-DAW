{
  "name": "OpenStudio DAW",
  "short_name": "OpenStudio",
  "description": "Open, cross-platform synthesizer, sampler and DAW",
  "start_url": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#0c0d0f",
